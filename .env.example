# 이 파일을 복사해 .env로 저장하고 실제 값을 채운다. .env는 git에 커밋되지 않는다.

# MySQL 8.4 접속 정보 (이미 떠 있는 DBMS 서버를 직접 가리킨다)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mockbroker
DB_USER=mockbroker
DB_PASSWORD=changeme

# 데모 회원가입 시스템 암호키. 실제 보안장치가 아니라 무분별한 계정 생성 방지용.
MOCKBROKER_SIGNUP_KEY=changeme

# 기본 클라이언트(Investory 백엔드) 부트스트랩용 client_id/client_secret.
MOCKBROKER_CLIENT_ID=investory
MOCKBROKER_CLIENT_SECRET=changeme

# 관제 콘솔(/connections.html) 로그인 계정. 실제 보안장치가 아니라 커넥션 현황을 아무나
# 못 보게 막는 최소한의 문.
MOCKBROKER_ADMIN_USER=admin
MOCKBROKER_ADMIN_PASSWORD=changeme

# (선택) false로 두면 네이버 시세 조회를 아예 하지 않는다 — 오프라인 발표 환경 등.
# 생략하면 true.
MOCKBROKER_QUOTE_ENABLED=true
